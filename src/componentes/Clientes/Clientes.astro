---
import "./clientes.css";

const clients = [
    {
        name: "Agro Tour El Llano",
        logo: "/imges/clientes/valencia_web_agro_tour_el_llano_logo.webp",
    },
    {
        name: "Amar Ropa Médica",
        logo: "/imges/clientes/valencia_web_amar_ropa_medica_logo.webp",
    },
    {
        name: "Corporación Somos La Trece",
        logo: "/imges/clientes/valencia_web_corporacion_somos_la_trece_logo.webp",
    },
    {
        name: "DJ Productor Black Criss",
        logo: "/imges/clientes/valencia_web_dj_productor_black_Criss_logo.webp",
    },
    {
        name: "Power Audio Producciones",
        logo: "/imges/clientes/valencia_web_power_audio_producciones_logo.webp",
    },
];
---

<section
    class="clientes-section"
    id="clientes"
    aria-labelledby="clientes-title"
>
    <div class="clientes-inner">
        <h2 id="clientes-title">Clientes</h2>
        <div class="clientes-grid">
            {
                clients.map((client) => (
                    <div class="cliente-logo">
                        <img src={client.logo} alt={`Logo de ${client.name}`} />
                    </div>
                ))
            }
        </div>
    </div>
</section>
