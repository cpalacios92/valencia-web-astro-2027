---
import "./footer.css";
---

<footer class="site-footer" id="contact">
    <div class="site-width footer-inner">
        <div>
            <p class="eyebrow">Tu próxima experiencia positiva empieza aquí</p>
            <h2>
                Hagamos que<br />merezca la pena<span class="period">.</span>
            </h2>
        </div>
        <div class="footer-contact">
            <a
                class="contact-link"
                href="https://wa.link/dm34jp"
                target="_blank"
                rel="noopener noreferrer"
            >
                Hablemos por WhatsApp <span aria-hidden="true">↗</span>
            </a>
        </div>
    </div>
    <div class="site-width footer-bottom">
        <a class="wordmark footer-wordmark" href="#top">
            <img
                class="footer-wordmark-logo"
                src="/imges/valencia_web_header_logo_white.png"
                alt="Valencia Web"
            />
        </a>
        <p>© 2026 Valencia Web</p>
        <a href="#top">Volver al inicio ↑</a>
    </div>
</footer>
