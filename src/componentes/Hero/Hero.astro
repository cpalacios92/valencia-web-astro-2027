---
import "./hero.css";
---

<section class="hero site-width" aria-labelledby="hero-title">
    <div class="hero-copy">
        <h1 id="hero-title">
            Las buenas páginas web<br />te hacen <span class="hero-accent"
                >sentir</span
            > algo<span class="period">.</span>
        </h1>
        <div class="hero-bottom">
            <p class="hero-description">
                Una recopilación de espacios digitales, detalles cuidados e
                ideas que cobran vida en la red.
            </p>
            <a class="text-link" href="#projects">
                Explora abajo <span aria-hidden="true">↓</span>
            </a>
        </div>
    </div>
</section>
