---
import "bootstrap/dist/css/bootstrap.min.css";
import Header from "../componentes/Header/Header.astro";
import Hero from "../componentes/Hero/Hero.astro";
import Work from "../componentes/Work/Work.astro";
import About from "../componentes/About/About.astro";

const projects = [
	{
		name: "Fika Objects",
		type: "Commerce",
		category: "shop",
		description:
			"A quieter kind of online shop for useful, well-made things.",
		image: "https://images.unsplash.com/photo-1503602642458-232111445657?auto=format&fit=crop&w=1200&q=85",
		alt: "Minimal wooden chair in a bright, modern interior",
		color: "clay",
	},
	{
		name: "Open Roads",
		type: "Travel",
		category: "web",
		description: "An editorial guide to taking the scenic route.",
		image: "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=85",
		alt: "Mountain landscape beneath a wide open sky",
		color: "blue",
	},
	{
		name: "Fika Objects",
		type: "Commerce",
		category: "shop",
		description:
			"A quieter kind of online shop for useful, well-made things.",
		image: "https://images.unsplash.com/photo-1503602642458-232111445657?auto=format&fit=crop&w=1200&q=85",
		alt: "Minimal wooden chair in a bright, modern interior",
		color: "clay",
	},
	{
		name: "Open Roads",
		type: "Travel",
		category: "web",
		description: "An editorial guide to taking the scenic route.",
		image: "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=85",
		alt: "Mountain landscape beneath a wide open sky",
		color: "blue",
	},
	{
		name: "Sunday Supply",
		type: "Identity + shop",
		category: "brand",
		description: "A sunny identity for a small-batch essentials label.",
		image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1200&q=85",
		alt: "Bright red sneaker photographed against a red background",
		color: "red",
	},
	{
		name: "Fieldnotes",
		type: "Studio",
		category: "web",
		description: "A digital home for a design practice rooted in nature.",
		image: "https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=1200&q=85",
		alt: "Sunlit table with coffee and a notebook",
		color: "green",
	},
	{
		name: "Form & Function",
		type: "Identity",
		category: "brand",
		description: "A flexible visual system for a modern interiors atelier.",
		image: "https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1200&q=85",
		alt: "Warm, considered creative studio with a desk and plants",
		color: "yellow",
	},
	{
		name: "The Daily Ritual",
		type: "Commerce",
		category: "shop",
		description: "A thoughtful storefront for everyday coffee rituals.",
		image: "https://images.unsplash.com/photo-1442512595367-427325f1fb72?auto=format&fit=crop&w=1200&q=85",
		alt: "Coffee being prepared in a bright cafe",
		color: "pink",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="A curated portfolio of websites, shops, and digital identities by Valencia Web."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin="anonymous"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Selected Work — Valencia Web</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<Hero />
			<Work projects={projects} />
			<About />
		</main>

		<footer class="site-footer" id="contact">
			<div class="site-width footer-inner">
				<div>
					<p class="eyebrow">Your next good thing starts here</p>
					<h2>
						Let's make it<br />matter<span class="period">.</span>
					</h2>
				</div>
				<div class="footer-contact">
					<a class="contact-link" href="mailto:hello@example.com"
						>hello@example.com <span aria-hidden="true">↗</span></a
					>
					<p>
						Valencia, Spain <span aria-hidden="true">·</span> Available
						worldwide
					</p>
				</div>
			</div>
			<div class="site-width footer-bottom">
				<a class="wordmark footer-wordmark" href="#top"
					><span class="wordmark-mark" aria-hidden="true">V</span
					><span>VALENCIA<span class="wordmark-light">WEB</span></span
					></a
				>
				<p>© 2026 Valencia Web</p>
				<a href="#top">Back to top ↑</a>
			</div>
		</footer>

		<script>
			import "bootstrap/dist/js/bootstrap.bundle.min.js";
		</script>
		<script>
			const filterButtons =
				document.querySelectorAll<HTMLButtonElement>("[data-filter]");
			const projectColumns =
				document.querySelectorAll<HTMLDivElement>("[data-category]");

			filterButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const selectedFilter = button.dataset.filter;

					filterButtons.forEach((filterButton) => {
						const isSelected = filterButton === button;
						filterButton.classList.toggle("is-active", isSelected);
						filterButton.setAttribute(
							"aria-pressed",
							String(isSelected),
						);
					});

					projectColumns.forEach((project) => {
						project.hidden =
							selectedFilter !== "all" &&
							project.dataset.category !== selectedFilter;
					});
				});
			});
		</script>

		<style>
			:global(:root) {
				--ink: #19201f;
				--muted: #737b77;
				--paper: #f4f5ef;
				--line: #d9ddd5;
				--orange: #fa6039;
				--acid: #d7ff6e;
				font-family: "DM Sans", sans-serif;
				color: var(--ink);
				background: var(--paper);
				font-synthesis: none;
				text-rendering: optimizeLegibility;
			}

			:global(*) {
				box-sizing: border-box;
			}

			:global(html) {
				scroll-behavior: smooth;
			}

			:global(body) {
				margin: 0;
				background: var(--paper);
				color: var(--ink);
				font-family: "DM Sans", sans-serif;
				font-size: 16px;
			}

			:global(a) {
				color: inherit;
				text-decoration: none;
			}

			.skip-link {
				position: absolute;
				z-index: 10;
				left: 16px;
				top: -48px;
				padding: 10px 14px;
				background: var(--acid);
				color: var(--ink);
			}

			.skip-link:focus {
				top: 16px;
			}

			.site-width {
				width: min(100% - 64px, 1320px);
				margin-inline: auto;
			}

			.footer-bottom {
				display: flex;
				align-items: center;
			}

			.wordmark {
				gap: 10px;
				font-family: "Space Grotesk", sans-serif;
				font-size: 15px;
				font-weight: 700;
				letter-spacing: 0;
			}

			.wordmark-light {
				font-weight: 400;
			}

			.wordmark-mark {
				display: grid;
				width: 34px;
				aspect-ratio: 1;
				place-items: center;
				background: var(--ink);
				color: var(--acid);
				font-family: "Space Grotesk", sans-serif;
				font-size: 19px;
			}

			.contact-link,
			.footer-bottom > a:last-child {
				transition: color 180ms ease;
			}

			.contact-link:hover,
			.footer-bottom > a:last-child:hover {
				color: var(--orange);
			}

			.eyebrow {
				margin: 0;
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0;
				text-transform: uppercase;
			}

			.status-dot {
				display: inline-block;
				width: 8px;
				height: 8px;
				margin-right: 8px;
				border-radius: 50%;
				background: var(--orange);
				vertical-align: 1px;
			}

			.eyebrow-place {
				margin-left: 7px;
				color: var(--muted);
				font-weight: 500;
			}

			.site-footer h2 {
				font-family: "Space Grotesk", sans-serif;
				font-weight: 500;
				letter-spacing: 0;
			}

			.period {
				color: var(--orange);
			}

			.work-section {
				padding: 94px 0 112px;
				background: #e8ece5;
			}

			.section-heading {
				display: flex;
				align-items: end;
				justify-content: space-between;
				margin-bottom: 32px;
			}

			.site-footer {
				padding: 78px 0 22px;
				background: var(--ink);
				color: var(--paper);
			}

			.footer-inner {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 40px;
				padding-bottom: 78px;
			}

			.site-footer .eyebrow {
				margin-bottom: 17px;
				color: #aeb8b0;
			}

			.site-footer h2 {
				margin: 0;
				font-size: 64px;
				line-height: 0.98;
			}

			.footer-contact {
				padding-bottom: 5px;
			}

			.contact-link {
				display: inline-flex;
				gap: 24px;
				align-items: center;
				padding-bottom: 8px;
				border-bottom: 1px solid #707a72;
				font-size: 20px;
				font-weight: 600;
			}

			.footer-contact p {
				margin: 14px 0 0;
				color: #aeb8b0;
				font-size: 12px;
			}

			.footer-bottom {
				min-height: 62px;
				justify-content: space-between;
				border-top: 1px solid #3d4640;
				color: #aeb8b0;
				font-size: 11px;
			}

			.footer-bottom p {
				margin: 0;
			}

			.footer-wordmark {
				color: var(--paper);
				font-size: 12px;
			}

			.footer-wordmark .wordmark-mark {
				width: 26px;
				background: var(--acid);
				color: var(--ink);
				font-size: 15px;
			}

			@media (max-width: 760px) {
				.site-width {
					width: min(100% - 40px, 600px);
				}

				.footer-inner {
					align-items: start;
					flex-direction: column;
					gap: 38px;
					padding-bottom: 58px;
				}

				.site-footer h2 {
					font-size: 56px;
				}
			}

			@media (max-width: 420px) {
				.site-width {
					width: min(100% - 32px, 600px);
				}

				.wordmark {
					gap: 7px;
					font-size: 13px;
				}

				.wordmark-mark {
					width: 29px;
					font-size: 16px;
				}

				.footer-bottom {
					gap: 8px;
					font-size: 9px;
				}

				.footer-wordmark {
					font-size: 10px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				:global(html) {
					scroll-behavior: auto;
				}
				.main-nav a,
				.contact-link,
				.footer-bottom > a:last-child {
					transition: none;
				}
			}
		</style>
	</body>
</html>
