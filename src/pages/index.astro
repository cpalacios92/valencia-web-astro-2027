---
import "bootstrap/dist/css/bootstrap.min.css";
import "../styles/global.css";
import Header from "../componentes/Header/Header.astro";
import Hero from "../componentes/Hero/Hero.astro";
import Work from "../componentes/Work/Work.astro";
import About from "../componentes/About/About.astro";
import Footer from "../componentes/Footer/Footer.astro";
import Clientes from "../componentes/Clientes/Clientes.astro";

const projects = [
	{
		name: "Fika Objects",
		type: "Commerce",
		category: "shop",
		description:
			"A quieter kind of online shop for useful, well-made things.",
		image: "https://images.unsplash.com/photo-1503602642458-232111445657?auto=format&fit=crop&w=1200&q=85",
		alt: "Minimal wooden chair in a bright, modern interior",
		color: "clay",
	},
	{
		name: "Open Roads",
		type: "Travel",
		category: "web",
		description: "An editorial guide to taking the scenic route.",
		image: "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=85",
		alt: "Mountain landscape beneath a wide open sky",
		color: "blue",
	},
	{
		name: "Sunday Supply",
		type: "Identity + shop",
		category: "brand",
		description: "A sunny identity for a small-batch essentials label.",
		image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1200&q=85",
		alt: "Bright red sneaker photographed against a red background",
		color: "red",
	},
	{
		name: "Fieldnotes",
		type: "Studio",
		category: "web",
		description: "A digital home for a design practice rooted in nature.",
		image: "https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=1200&q=85",
		alt: "Sunlit table with coffee and a notebook",
		color: "green",
	},
	{
		name: "Form & Function",
		type: "Identity",
		category: "brand",
		description: "A flexible visual system for a modern interiors atelier.",
		image: "https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1200&q=85",
		alt: "Warm, considered creative studio with a desk and plants",
		color: "yellow",
	},
	{
		name: "The Daily Ritual",
		type: "Commerce",
		category: "shop",
		description: "A thoughtful storefront for everyday coffee rituals.",
		image: "https://images.unsplash.com/photo-1442512595367-427325f1fb72?auto=format&fit=crop&w=1200&q=85",
		alt: "Coffee being prepared in a bright cafe",
		color: "pink",
	},
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Una selección de sitios web, tiendas e identidades digitales de Valencia Web."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin="anonymous"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Proyectos seleccionados — Valencia Web</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<Hero />
			<Work projects={projects} />
			<Clientes />
			<About />
		</main>

		<Footer />

		<script>
			const filterButtons =
				document.querySelectorAll<HTMLButtonElement>("[data-filter]");
			const projectColumns =
				document.querySelectorAll<HTMLDivElement>("[data-category]");

			filterButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const selectedFilter = button.dataset.filter;

					filterButtons.forEach((filterButton) => {
						const isSelected = filterButton === button;
						filterButton.classList.toggle("is-active", isSelected);
						filterButton.setAttribute(
							"aria-pressed",
							String(isSelected),
						);
					});

					projectColumns.forEach((project) => {
						project.hidden =
							selectedFilter !== "all" &&
							project.dataset.category !== selectedFilter;
					});
				});
			});
		</script>
	</body>
</html>
