---
import "bootstrap/dist/css/bootstrap.min.css";
import Header from "../componentes/Header/Header.astro";
import Hero from "../componentes/Hero/Hero.astro";

const projects = [
	{
		name: "Fika Objects",
		type: "Commerce",
		category: "shop",
		description:
			"A quieter kind of online shop for useful, well-made things.",
		image: "https://images.unsplash.com/photo-1503602642458-232111445657?auto=format&fit=crop&w=1200&q=85",
		alt: "Minimal wooden chair in a bright, modern interior",
		color: "clay",
	},
	{
		name: "Open Roads",
		type: "Travel",
		category: "web",
		description: "An editorial guide to taking the scenic route.",
		image: "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=85",
		alt: "Mountain landscape beneath a wide open sky",
		color: "blue",
	},
	{
		name: "Sunday Supply",
		type: "Identity + shop",
		category: "brand",
		description: "A sunny identity for a small-batch essentials label.",
		image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1200&q=85",
		alt: "Bright red sneaker photographed against a red background",
		color: "red",
	},
	{
		name: "Fieldnotes",
		type: "Studio",
		category: "web",
		description: "A digital home for a design practice rooted in nature.",
		image: "https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=1200&q=85",
		alt: "Sunlit table with coffee and a notebook",
		color: "green",
	},
	{
		name: "Form & Function",
		type: "Identity",
		category: "brand",
		description: "A flexible visual system for a modern interiors atelier.",
		image: "https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1200&q=85",
		alt: "Warm, considered creative studio with a desk and plants",
		color: "yellow",
	},
	{
		name: "The Daily Ritual",
		type: "Commerce",
		category: "shop",
		description: "A thoughtful storefront for everyday coffee rituals.",
		image: "https://images.unsplash.com/photo-1442512595367-427325f1fb72?auto=format&fit=crop&w=1200&q=85",
		alt: "Coffee being prepared in a bright cafe",
		color: "pink",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="A curated portfolio of websites, shops, and digital identities by Valencia Web."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin="anonymous"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Selected Work — Valencia Web</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />

		<main id="main">
			<Hero />

			<section
				class="work-section"
				id="projects"
				aria-labelledby="work-title"
			>
				<div class="site-width">
					<div class="section-heading">
						<div>
							<p class="eyebrow section-eyebrow">
								A few things made with care
							</p>
							<h2 id="work-title">
								Selected work<span class="period">.</span>
							</h2>
						</div>
						<p class="work-count"><span>01</span> — 06</p>
					</div>

					<div
						class="filters"
						role="group"
						aria-label="Filter projects by category"
					>
						<button
							class="btn filter-btn is-active"
							type="button"
							data-filter="all"
							aria-pressed="true">All work <span>06</span></button
						>
						<button
							class="btn filter-btn"
							type="button"
							data-filter="web"
							aria-pressed="false">Websites</button
						>
						<button
							class="btn filter-btn"
							type="button"
							data-filter="shop"
							aria-pressed="false">E-commerce</button
						>
						<button
							class="btn filter-btn"
							type="button"
							data-filter="brand"
							aria-pressed="false">Branding</button
						>
					</div>

					<div class="row g-4 project-grid">
						{
							projects.map((project, index) => (
								<div
									class="col-12 col-md-6 col-lg-4 project-column"
									data-category={project.category}
								>
									<article
										class:list={[
											"card",
											"project-card",
											`tone-${project.color}`,
										]}
									>
										<div class="project-image-wrap">
											<img
												class="project-image"
												src={project.image}
												alt={project.alt}
												loading={
													index < 2 ? "eager" : "lazy"
												}
											/>
											<span class="project-number">
												0{index + 1}
											</span>
											<span class="concept-label">
												Concept study
											</span>
										</div>
										<div class="card-body project-body">
											<div class="project-meta">
												<>
													<span>{project.type}</span>
													<span
														class="meta-line"
														aria-hidden="true"
													/>
													<span>Sample</span>
												</>
											</div>
											<h3 class="card-title">
												{project.name}
											</h3>
											<p class="card-text">
												{project.description}
											</p>
										</div>
									</article>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section
				class="about-section site-width"
				id="about"
				aria-labelledby="about-title"
			>
				<div class="about-mark" aria-hidden="true">
					VW<span>®</span>
				</div>
				<div class="about-copy">
					<p class="eyebrow">A little about this space</p>
					<h2 id="about-title">
						Digital work,<br />made with <span>intention.</span>
					</h2>
					<p class="about-description">
						From first sketch to final scroll, this is a home for
						websites that bring a point of view to the screen.
						Strategy, design, and development, all in one place.
					</p>
					<a class="text-link" href="#contact"
						>Have something in mind? <span aria-hidden="true"
							>↗</span
						></a
					>
				</div>
				<div class="about-side-note">
					DESIGN<br />DEVELOPMENT<br />DETAILS
				</div>
			</section>
		</main>

		<footer class="site-footer" id="contact">
			<div class="site-width footer-inner">
				<div>
					<p class="eyebrow">Your next good thing starts here</p>
					<h2>
						Let's make it<br />matter<span class="period">.</span>
					</h2>
				</div>
				<div class="footer-contact">
					<a class="contact-link" href="mailto:hello@example.com"
						>hello@example.com <span aria-hidden="true">↗</span></a
					>
					<p>
						Valencia, Spain <span aria-hidden="true">·</span> Available
						worldwide
					</p>
				</div>
			</div>
			<div class="site-width footer-bottom">
				<a class="wordmark footer-wordmark" href="#top"
					><span class="wordmark-mark" aria-hidden="true">V</span
					><span>VALENCIA<span class="wordmark-light">WEB</span></span
					></a
				>
				<p>© 2026 Valencia Web</p>
				<a href="#top">Back to top ↑</a>
			</div>
		</footer>

		<script>
			import "bootstrap/dist/js/bootstrap.bundle.min.js";
		</script>
		<script>
			const filterButtons = document.querySelectorAll("[data-filter]");
			const projectColumns = document.querySelectorAll("[data-category]");

			filterButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const selectedFilter = button.dataset.filter;

					filterButtons.forEach((filterButton) => {
						const isSelected = filterButton === button;
						filterButton.classList.toggle("is-active", isSelected);
						filterButton.setAttribute(
							"aria-pressed",
							String(isSelected),
						);
					});

					projectColumns.forEach((project) => {
						project.hidden =
							selectedFilter !== "all" &&
							project.dataset.category !== selectedFilter;
					});
				});
			});
		</script>
	</body>
</html>

<style>
	:global(:root) {
		--ink: #19201f;
		--muted: #737b77;
		--paper: #f4f5ef;
		--line: #d9ddd5;
		--orange: #fa6039;
		--acid: #d7ff6e;
		font-family: "DM Sans", sans-serif;
		color: var(--ink);
		background: var(--paper);
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: "DM Sans", sans-serif;
		font-size: 16px;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.skip-link {
		position: absolute;
		z-index: 10;
		left: 16px;
		top: -48px;
		padding: 10px 14px;
		background: var(--acid);
		color: var(--ink);
	}

	.skip-link:focus {
		top: 16px;
	}

	.site-width {
		width: min(100% - 64px, 1320px);
		margin-inline: auto;
	}

	.footer-bottom {
		display: flex;
		align-items: center;
	}

	.wordmark {
		gap: 10px;
		font-family: "Space Grotesk", sans-serif;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0;
	}

	.wordmark-light {
		font-weight: 400;
	}

	.wordmark-mark {
		display: grid;
		width: 34px;
		aspect-ratio: 1;
		place-items: center;
		background: var(--ink);
		color: var(--acid);
		font-family: "Space Grotesk", sans-serif;
		font-size: 19px;
	}

	.text-link,
	.contact-link,
	.footer-bottom > a:last-child {
		transition: color 180ms ease;
	}

	.text-link:hover,
	.contact-link:hover,
	.footer-bottom > a:last-child:hover {
		color: var(--orange);
	}

	.eyebrow {
		margin: 0;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.status-dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 8px;
		border-radius: 50%;
		background: var(--orange);
		vertical-align: 1px;
	}

	.eyebrow-place {
		margin-left: 7px;
		color: var(--muted);
		font-weight: 500;
	}

	.section-heading h2,
	.about-copy h2,
	.site-footer h2 {
		font-family: "Space Grotesk", sans-serif;
		font-weight: 500;
		letter-spacing: 0;
	}

	.period {
		color: var(--orange);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 20px;
		padding-bottom: 7px;
		border-bottom: 1px solid var(--ink);
		font-size: 13px;
		font-weight: 700;
		white-space: nowrap;
	}

	.work-section {
		padding: 94px 0 112px;
		background: #e8ece5;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		margin-bottom: 32px;
	}

	.section-eyebrow {
		margin-bottom: 12px;
		color: var(--muted);
	}

	.section-heading h2 {
		margin: 0;
		font-size: 48px;
		line-height: 1;
	}

	.work-count {
		margin: 0 0 5px;
		color: var(--muted);
		font-size: 12px;
	}

	.work-count span {
		color: var(--ink);
		font-weight: 700;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 30px;
	}

	.filter-btn {
		min-height: 40px;
		padding: 9px 14px;
		border: 1px solid #c8cec5;
		border-radius: 0;
		background: transparent;
		color: #505954;
		font-family: "DM Sans", sans-serif;
		font-size: 12px;
		font-weight: 600;
	}

	.filter-btn:hover,
	.filter-btn.is-active {
		border-color: var(--ink);
		background: var(--ink);
		color: #fff;
	}

	.filter-btn span {
		margin-left: 5px;
		color: var(--acid);
		font-size: 10px;
	}

	.project-column[hidden] {
		display: none;
	}

	.project-card {
		height: 100%;
		overflow: hidden;
		border: 0;
		border-radius: 0;
		background: transparent;
		animation: rise-in 500ms both;
	}

	.project-column:nth-child(2) .project-card {
		animation-delay: 60ms;
	}
	.project-column:nth-child(3) .project-card {
		animation-delay: 120ms;
	}
	.project-column:nth-child(4) .project-card {
		animation-delay: 180ms;
	}
	.project-column:nth-child(5) .project-card {
		animation-delay: 240ms;
	}
	.project-column:nth-child(6) .project-card {
		animation-delay: 300ms;
	}

	.project-image-wrap {
		position: relative;
		aspect-ratio: 1.36;
		overflow: hidden;
		background: #d2d5cf;
	}

	.project-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.project-card:hover .project-image {
		transform: scale(1.04);
	}

	.project-number,
	.concept-label {
		position: absolute;
		top: 14px;
		padding: 7px 9px;
		background: var(--paper);
		color: var(--ink);
		font-size: 9px;
		font-weight: 700;
		text-transform: uppercase;
	}

	.project-number {
		left: 14px;
	}

	.concept-label {
		right: 14px;
		background: var(--acid);
	}

	.project-body {
		padding: 18px 2px 8px;
	}

	.project-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 8px;
		color: var(--muted);
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
	}

	.meta-line {
		width: 18px;
		height: 1px;
		background: #aeb5ae;
	}

	.project-body .card-title {
		margin-bottom: 5px;
		font-family: "Space Grotesk", sans-serif;
		font-size: 21px;
		font-weight: 500;
	}

	.project-body .card-text {
		max-width: 340px;
		margin: 0;
		color: #646d68;
		font-size: 13px;
		line-height: 1.55;
	}

	.tone-clay .project-number {
		background: #f4d7c4;
	}
	.tone-blue .project-number {
		background: #c9e1e6;
	}
	.tone-red .project-number {
		background: #f0c5b6;
	}
	.tone-green .project-number {
		background: #d5e4c7;
	}
	.tone-yellow .project-number {
		background: #eee0a7;
	}
	.tone-pink .project-number {
		background: #efcbd4;
	}

	.about-section {
		position: relative;
		display: grid;
		min-height: 560px;
		grid-template-columns: 0.8fr 1.5fr 0.5fr;
		align-items: center;
		gap: 40px;
		padding-block: 110px;
	}

	.about-mark {
		color: var(--orange);
		font-family: "Space Grotesk", sans-serif;
		font-size: clamp(110px, 17vw, 220px);
		font-weight: 700;
		line-height: 0.8;
	}

	.about-mark span {
		position: relative;
		top: -5em;
		font-family: "DM Sans", sans-serif;
		font-size: 14px;
		font-weight: 500;
	}

	.about-copy .eyebrow {
		margin-bottom: 18px;
		color: var(--muted);
	}

	.about-copy h2 {
		margin: 0 0 20px;
		font-size: 56px;
		line-height: 1.03;
	}

	.about-copy h2 span {
		color: var(--orange);
		font-style: italic;
	}

	.about-description {
		max-width: 470px;
		margin: 0 0 23px;
		color: #59615d;
		font-size: 15px;
		line-height: 1.7;
	}

	.about-side-note {
		justify-self: end;
		padding-left: 18px;
		border-left: 1px solid var(--line);
		color: var(--muted);
		font-size: 9px;
		font-weight: 700;
		line-height: 2;
	}

	.site-footer {
		padding: 78px 0 22px;
		background: var(--ink);
		color: var(--paper);
	}

	.footer-inner {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 40px;
		padding-bottom: 78px;
	}

	.site-footer .eyebrow {
		margin-bottom: 17px;
		color: #aeb8b0;
	}

	.site-footer h2 {
		margin: 0;
		font-size: 64px;
		line-height: 0.98;
	}

	.footer-contact {
		padding-bottom: 5px;
	}

	.contact-link {
		display: inline-flex;
		gap: 24px;
		align-items: center;
		padding-bottom: 8px;
		border-bottom: 1px solid #707a72;
		font-size: 20px;
		font-weight: 600;
	}

	.footer-contact p {
		margin: 14px 0 0;
		color: #aeb8b0;
		font-size: 12px;
	}

	.footer-bottom {
		min-height: 62px;
		justify-content: space-between;
		border-top: 1px solid #3d4640;
		color: #aeb8b0;
		font-size: 11px;
	}

	.footer-bottom p {
		margin: 0;
	}

	.footer-wordmark {
		color: var(--paper);
		font-size: 12px;
	}

	.footer-wordmark .wordmark-mark {
		width: 26px;
		background: var(--acid);
		color: var(--ink);
		font-size: 15px;
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 760px) {
		.site-width {
			width: min(100% - 40px, 600px);
		}

		.work-section {
			padding-block: 70px 78px;
		}

		.section-heading h2 {
			font-size: 39px;
		}

		.about-section {
			min-height: auto;
			grid-template-columns: 1fr auto;
			gap: 10px 24px;
			padding-block: 78px;
		}

		.about-mark {
			grid-column: 1 / -1;
			font-size: 108px;
		}

		.about-copy h2 {
			font-size: 46px;
		}

		.about-side-note {
			align-self: end;
			margin-bottom: 12px;
		}

		.footer-inner {
			align-items: start;
			flex-direction: column;
			gap: 38px;
			padding-bottom: 58px;
		}

		.site-footer h2 {
			font-size: 56px;
		}
	}

	@media (max-width: 420px) {
		.site-width {
			width: min(100% - 32px, 600px);
		}

		.wordmark {
			gap: 7px;
			font-size: 13px;
		}

		.wordmark-mark {
			width: 29px;
			font-size: 16px;
		}

		.section-heading h2 {
			font-size: 34px;
		}

		.work-count {
			font-size: 10px;
		}

		.filters {
			gap: 6px;
		}

		.filter-btn {
			min-height: 36px;
			padding: 7px 10px;
			font-size: 11px;
		}

		.about-section {
			grid-template-columns: 1fr;
		}

		.about-side-note {
			display: none;
		}

		.about-copy h2 {
			font-size: 42px;
		}

		.footer-bottom {
			gap: 8px;
			font-size: 9px;
		}

		.footer-wordmark {
			font-size: 10px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}
		.project-card {
			animation: none;
		}
		.project-image,
		.main-nav a,
		.text-link,
		.contact-link,
		.footer-bottom > a:last-child {
			transition: none;
		}
	}
</style>
